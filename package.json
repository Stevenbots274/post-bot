{
  "name": "post-bot",
  "version": "1.0.0",
  "private": true,
  "description": "A Telegram bot for creating, formatting, previewing, and publishing posts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "set-webhook": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "mongodb": "^6.13.0",
    "pg": "^8.13.1",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
