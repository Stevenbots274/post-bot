# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook

# Database provider: supabase, neon, or mongodb
DB_PROVIDER=supabase

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Neon/PostgreSQL (used when DB_PROVIDER=neon)
DATABASE_URL=

# MongoDB (used when DB_PROVIDER=mongodb)
MONGODB_URI=
MONGODB_DATABASE=post_bot

# Runtime
# APP_PORT overrides a host-provided PORT. Leave blank on Railway, Koyeb, Render, or similar hosts.
APP_PORT=
APP_URL=
BOT_USERNAME=
BOT_NAME=
BOT_DESCRIPTION=
BOT_SHORT_DESCRIPTION=
# Public JPG URL or a JPG path included in the deployment
BOT_PROFILE_PHOTO=
ADMIN_TELEGRAM_USER_IDS=

# Never commit real values.
